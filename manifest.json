{
  "manifest_version": 3,
  "name": "ChatJump",
  "version": "1.0",
  "description": "Jump to any question in your AI chat conversations instantly",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "gemini.js"
      ]
    },
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "chatgpt.js"
      ]
    },
    {
      "matches": [
        "https://deepseek.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "deepseek.js"
      ]
    }
  ]
}
